    <object className="ScriptedLong" dimension="" handle="" name="switchToX">
      <param name="getScript" index="" value="#PCDATA">
        value
      </param>
      <param name="setScript" index="" value="#PCDATA">
        void setReference(String ref,String var) {
        def refObject=me.getParent().getChild(ref)
        println "refObject ${refObject.getPVObject()}"
        println "var.handle ${me.objectNameToHandle(var)}"
        println "refObject.getPVObject().forwardHandle(before): ${refObject.getPVObject().forwardHandle}"
        refObject.getPVObject().forwardHandle=me.objectNameToHandle(var)
        println "refObject.getPVObject().forwardHandle(after ): ${refObject.getPVObject().forwardHandle}"
        }
        switch(value) {
        case 1:
        setReference("vRemoteBufferA", "vir/remoteBufferA")
        setReference("vRemoteBufferB", "vir/remoteBufferB")
        break
        case 2:
        setReference("vRemoteBufferA", "vir/remoteBufferB")
        setReference("vRemoteBufferB", "vir/remoteBufferA")
        break
        }
      </param>
