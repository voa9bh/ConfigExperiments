amends "SchemaMapping.pkl"

configuration {
  children {
    ["dev"] = new Dev {
      children {
        ["timer"] = new Timer {}
        ["system"] = new PVSystem {}
        for (i: Int in IntSeq(1, 3)) {
          ["pvClient\(i)"] = new PVClient {
            hostName = "123.4.3.4"
            port = 5002 + i
          }
        }
      }
    }
  }
}
