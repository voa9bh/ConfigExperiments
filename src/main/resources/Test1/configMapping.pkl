amends "SchemaMapping.pkl"

import "DefaultBlocks.pkl" as DefaultBlocks

// ── Pass 1: base definition ──
local config = new Mapping<String,PVObject> {
  ["dev"] = new Dev {
    children {
      ["timer"] = new Timer {}
      ["system"] = new PVSystem {}
      for (i: Int in IntSeq(1, 3)) {
        ["pvClient\(i)"] = new PVClient {
          hostName = "123.4.3.4"
          port = 5002 + i
        }
      }
    }
  }
  for( i: Int in IntSeq(1, 3)) {
    ["procs\(i)"] = DefaultBlocks.createDefaultProcs("\(i)")
  }
}

// ── Pass 2: fixup some parameters (just for fun) ──
configuration = (config) {
  ["dev"] {
    children {
      ["pvClient2"] { port = 8000 }
    }
  }
  ["procs2"] {
    children {
      ["console2"] { hConnector = List("netConnector","webSocket") }
    }
  }
}
