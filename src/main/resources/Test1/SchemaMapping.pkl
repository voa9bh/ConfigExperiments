module SpexConfig

import "pkl:xml"

configuration: Mapping<String, PVObject> = new {
  ["dev"] = new Dev {}
}

/// Base class for system objects with common properties
abstract class PVObject {
  /// Populated automatically from the mapping key (see `fixupNames`).
  name: String = ""

  handle: Int = 0
  dimension: Int = 1
  classType: String
  children: Mapping<String, PVObject>?
  forwardHandle: (Int | String)?
  gatewayHandle: PVClient?
}

open class PVServer extends PVObject {
  classType = "PVServer"
  handle = 1
}

/// Remote connection client to other test systems (PVGateway)
open class PVClient extends PVObject {
  classType = "PVClient"
  /// TCP/IP port number (REQUIRED)
  port: Int
  /// Hostname or IP address of remote device (REQUIRED)
  /// Pattern: hostname starting with letter, or valid IPv4 address
  hostName: String(
    matches(Regex("^([a-zA-Z][\\w\\.]*)|([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})")),
  ) = "localhost"
  /// Protocol (0=plain Socket) (OPTIONAL)
  protocol: Int?
  /// Log mode for communication: 0=no logging 1=full logging 2=debug 3=trace (OPTIONAL)
  loggingEnabled: Int? = 0
  /// Number of attempts to connect to the target (OPTIONAL)
  retryCount: Int? = 100
  /// Timeout after a retry is started (in ms) (OPTIONAL)
  timeout: Int? = 2500
  /// Description of the connection (only information) (OPTIONAL)
  description: String?
  /// Handle of lookup object (OPTIONAL)
  hLookup: PVObject?
  /// Set to support async messages (OPTIONAL)
  asyncEnabled: Int?
  /// The SocketConnector for sending asynchronous messages (needed if asyncEnabled=1) (OPTIONAL)
  hConnector: Listing<PVObject>?
  /// The process object which administrates the application (OPTIONAL)
  hSubProcess: PVObject?
  /// 0=No resend (e.g. if expected value will not be valid) (OPTIONAL)
  resendAfterReconnect: Int? = 1
  /// 1=client will ask for binary responses for faster transfer (OPTIONAL)
  useBinaryResponse: Int?
  /// 1=client will use big packet for faster transfer (OPTIONAL)
  useBigPacket: Int?
  /// 1=client is connected (OPTIONAL)
  isConnected: Int?
  /// Use future packages (OPTIONAL)
  useFuturePacket: Int?
}

/// Structure-element for device/hardware objects
open class Dev extends PVObject {
  classType = "Dev"
}

open class Procs extends PVObject {
  classType = "Procs"
}

open class Timer extends PVObject {
  classType = "Timer"
}

open class PVSystem extends PVObject {
  classType = "PVSystem"
}

open class PVConsole extends PVObject {
  classType = "PVConsole"
  hConnector: (String | Int | List<String | Int>)?
}

/// Recursively assigns each object's `name` from its mapping key.
/// This lets config authors specify the name once (as the mapping key)
/// instead of repeating it in a `name` property.
///
/// Used for programmatic access via `resolved` (see below).
local function fixupNames(m: Mapping<String, PVObject>): Mapping<String, PVObject> =
  m
    .toMap()
    .map((key, node) ->
      Pair(key, (node) {
        name = key
        children = if (node.children != null) fixupNames(node.children!!) else node.children
      })
    )
    .toMapping()

/// Helper function to get all properties of a PVClient that should be rendered as <param> tags
local function getPVClientParams(pvClient: PVClient): Listing = new {
  (xml.Element("param")) {
    attributes {
      ["name"] = "port"
      ["value"] = pvClient.port
      ["index"] = ""
    }
  }
  (xml.Element("param")) {
    attributes {
      ["name"] = "hostName"
      ["value"] = pvClient.hostName
      ["index"] = ""
    }
  }
  when (pvClient.protocol != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "protocol"
        ["value"] = pvClient.protocol
        ["index"] = ""
      }
    }
  }
  when (pvClient.loggingEnabled != null && pvClient.loggingEnabled != 0) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "loggingEnabled"
        ["value"] = pvClient.loggingEnabled
        ["index"] = ""
      }
    }
  }
  when (pvClient.retryCount != null && pvClient.retryCount != 100) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "retryCount"
        ["value"] = pvClient.retryCount
        ["index"] = ""
      }
    }
  }
  when (pvClient.timeout != null && pvClient.timeout != 2500) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "timeout"
        ["value"] = pvClient.timeout
        ["index"] = ""
      }
    }
  }
  when (pvClient.description != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "description"
        ["value"] = pvClient.description
        ["index"] = ""
      }
    }
  }
  when (pvClient.hLookup != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "hLookup"
        ["value"] = pvClient.hLookup.name
        ["index"] = ""
      }
    }
  }
  when (pvClient.hConnector != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "hConnector"
        ["value"] = if (pvClient.hConnector!!.length == 1) pvClient.hConnector!!.first.name else pvClient.hConnector!!.map((it) -> it.name).join(";")
        ["index"] = ""
      }
    }
  }
  when (pvClient.hSubProcess != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "hSubProcess"
        ["value"] = pvClient.hSubProcess.name
        ["index"] = ""
      }
    }
  }
  when (pvClient.resendAfterReconnect != null && pvClient.resendAfterReconnect != 1) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "resendAfterReconnect"
        ["value"] = pvClient.resendAfterReconnect
        ["index"] = ""
      }
    }
  }
  when (pvClient.useBinaryResponse != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "useBinaryResponse"
        ["value"] = pvClient.useBinaryResponse
        ["index"] = ""
      }
    }
  }
  when (pvClient.useBigPacket != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "useBigPacket"
        ["value"] = pvClient.useBigPacket
        ["index"] = ""
      }
    }
  }
  when (pvClient.isConnected != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "isConnected"
        ["value"] = pvClient.isConnected
        ["index"] = ""
      }
    }
  }
  when (pvClient.useFuturePacket != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "useFuturePacket"
        ["value"] = pvClient.useFuturePacket
        ["index"] = ""
      }
    }
  }
}

/// Helper function to get properties of a PVConsole that should be rendered as <param> tags
local function getPVConsoleParams(pvConsole: PVConsole): Listing = new {
  when (pvConsole.hConnector != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "hConnector"
        ["value"] = if (pvConsole.hConnector!! is String)
          pvConsole.hConnector!! as String
        else if (pvConsole.hConnector!! is Int)
          (pvConsole.hConnector!! as Int).toString()
        else if (pvConsole.hConnector!! is List<String | Int>)
          (pvConsole.hConnector!! as List<String | Int>).map((it) -> it.toString()).join(";")
        else
          ""
        ["index"] = ""
      }
    }
  }
}

/// Helper function to get all properties of a PVObject that should be rendered as <param> tags
local function getParams(node: PVObject): Listing = new {
  when (node.handle != 0) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "handle"
        ["value"] = node.handle
        ["index"] = ""
      }
    }
  }
  when (node.dimension != 0 && node.dimension != 1) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "dimension"
        ["value"] = node.dimension
        ["index"] = ""
      }
    }
  }
  when (node.forwardHandle != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "forwardHandle"
        ["value"] = node.forwardHandle.toString()
        ["index"] = ""
      }
    }
  }
  when (node.gatewayHandle != null) {
    (xml.Element("param")) {
      attributes {
        ["name"] = "gatewayHandle"
        ["value"] = node.gatewayHandle.name
        ["index"] = ""
      }
    }
  }
  // Render type-specific parameters for PVClient
  when (node is PVClient) {
    ...getPVClientParams(node as PVClient)
  }
  // Render type-specific parameters for PVConsole
  when (node is PVConsole) {
    ...getPVConsoleParams(node as PVConsole)
  }
}

/// Recursively converts the object tree into XML `<object>` elements.
///
/// Each `PVObject` renders as:
/// `<object className="..." dimension="..." handle="..." name="...">`
/// with its children and <param> tags nested inside. The mapping key becomes the `name`
/// attribute (so names don't need to be repeated in the config).
local function fixupChildren(m: Mapping<String, PVObject>): Listing = new {
  for (key, node in m) {
    (xml.Element("object")) {
      attributes {
        ["className"] = node.classType
        ["dimension"] = if (node.dimension == 0 || node.dimension == 1) "" else node.dimension
        ["handle"] = if (node.handle != 0) node.handle else ""
        ["name"] = key
      }
      // Render all properties as <param> elements
      ...getParams(node)
      // Render child objects
      when (node.children != null) {
        ...fixupChildren(node.children!!)
      }
    }
  }
}

/// The configuration with names resolved from mapping keys.
/// Use this for programmatic access (e.g. `resolved.children["dev"].name`).
resolved: Mapping<String, PVObject> = fixupNames(configuration)

// Render the object tree as XML with a `<configuration>` root element.
output {
  value = new Dynamic { ...fixupChildren(configuration) }
  renderer = new xml.Renderer {
    rootElementName = "configuration"
  }
}
